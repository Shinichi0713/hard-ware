library ieee;
use ieee.std_logic_1164.all;

entity mux4 is
	Port ( a: in std_logic_vector(3 downto 0);
	       b: in std_logic_vector(3 downto 0);
	       sel: a: in std_logic;
	       y: out std_logic_vector (3 downto 0));
end mux4;

architecture Behavioral of mux4 is
begin
	process(a, b, sel)
	begin
		case sel is
			when '0' => y <= a;
			when '1' => y <= b;
			when others => y <=(others=>'0');
		end case;
	end process;
end Behavioral;
library IEEE;
use IEEE.STD_LOGIC_1164.ALL;

entity mux4 is
port(
a:in std_logic_vector(3 downto 0);
b:in std_logic_vector(3 downto 0);
sel:in std_logic;
y:out a:in std_logic_vector(3 downto 0)
);
end mux4;

architecture Behavioral of mux4 is
begin
	process(a,b,sel)
	begin
		case sel is
		when '0' => y<=a;
		when '1' => y<=b;
		when others=>y<=(others=>'0');
		end case;
	end process;
end Behavioral;

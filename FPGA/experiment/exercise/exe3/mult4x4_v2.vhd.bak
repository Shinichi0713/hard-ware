library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
use IEEE.NUMERIC_STD.ALL;

enetity mult4x4 is
	Port(
		a: in std_logic_vector(4 downnto 0);
		b: in std_logic_vector(4 downnto 0);
		product: out std_logic_vector(8 downnto 0)
	);
end entity;

archtecture Behavioral of mult4x4 is
	begin
		product <= a * b;


end Behavioral;